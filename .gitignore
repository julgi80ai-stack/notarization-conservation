# The shipped verbatim logs MUST be tracked.  The repository root ignores
# *.log, which silently kept logs/ out of every commit while README.md said
# "a verbatim run is in logs/anc_reproduce.log" — so a fresh clone had no
# logs/ at all and the README pointed at nothing.  Un-ignore them here.
!logs/
!logs/*.log

# tlapm fingerprint cache — must NOT ship: a clean clone re-proves from scratch.
specs/.tlacache/

# TLC scratch
specs/states/
specs/*.toolbox/

# external tool (fetch per README §1)
tla2tools.jar

# checker scratch (regenerated by check.sh)
checker/gen/
checker/gen3/
checker/__pycache__/
