       NEW CONSTANT L,
       NEW CONSTANT Bot,
       NEW CONSTANT Surfaces,
       NEW CONSTANT Mem(_),
       NEW CONSTANT Rel(_, _),
       NEW CONSTANT G,
       NEW CONSTANT lbl,
       NEW CONSTANT r \in E,
       ASSUME NEW CONSTANT r_1 \in E
       PROVE  r_1 \in Reach <=> r_1 \in G \/ (\E x \in Reach : Edge(x, r_1)) ,
       (\E x \in Reach : Edge(x, r))
       <=> (\E x \in Reach, S \in Surfaces : <<x, r>> \in Rel(S, lbl)) 
PROVE  r \notin Reach
       <=> r \notin G
           /\ (\A x \in Reach, S \in Surfaces : <<x, r>> \notin Rel(S, lbl))

@!!END

